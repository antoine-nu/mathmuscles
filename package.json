{
  "name": "mathmuscles",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "build:usb": "npm run build && node scripts/build-usb.mjs",
    "check:exercises": "esbuild scripts/check-exercises.ts --bundle --platform=node --log-level=warning --outfile=node_modules/.cache/check-exercises.cjs && node node_modules/.cache/check-exercises.cjs",
    "balance": "esbuild scripts/balance.ts --bundle --platform=node --log-level=warning --outfile=node_modules/.cache/balance.cjs && node node_modules/.cache/balance.cjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "trystero": "0.25.4"
  },
  "devDependencies": {
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
